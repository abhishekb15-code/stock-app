# Server
PORT=5000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://username:password@localhost:5432/stockapp

# Redis (optional for caching)
REDIS_URL=redis://localhost:6379

# Email (Gmail SMTP)
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
EMAIL_RECIPIENT=recipient@gmail.com

# Market Data APIs (leave blank to use mock data)
ALPHA_VANTAGE_API_KEY=
YAHOO_FINANCE_API_KEY=

# AI Summaries (leave blank to use template summaries)
OPENAI_API_KEY=

# Use mock data (true = no real API calls, great for development)
USE_MOCK_DATA=true
